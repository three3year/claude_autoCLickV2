.venv/
__pycache__/
*.pyc
.pytest_cache/
# 引擎基準測試集的衍生資料 (benchmark 本身進版控)
profiles/*/benchmark/_registered/
profiles/*/benchmark/_assets/_registered/
# 退場的 profile 留在本機的舊使用者資料 (流程已轉成流程資料夾; 不進版控)
profiles/*/flows/
profiles/*/workspace/
profiles/*/calibration/
profiles/*/calibration.json
profiles/app_state.json
autoclick.log
autoclick.log.1
# 原始碼執行的本機狀態資料夾 (state.json、autoclick.log、未存檔快取; apppaths)
.local/
.scratch/**/tmp/
*.egg-info/
build/
dist/
# coord-anchor 一次性換算的產物與改前副本 (流程存檔含範本圖, 使用者資料)
.scratch/coord-anchor/converted/
.scratch/coord-anchor/backup/
.scratch/coord-anchor/results/convert.log
